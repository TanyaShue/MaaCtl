{
  "name": "maactl",
  "version": "0.1.0",
  "description": "MaaFramework / ProjectInterface v2 command-line client, runnable with npx on Windows, Linux and macOS",
  "keywords": [
    "maactl",
    "maafw",
    "maaframework",
    "projectinterface",
    "automation",
    "adb",
    "cli"
  ],
  "license": "MIT",
  "author": "TanyaShue",
  "homepage": "https://github.com/TanyaShue/MaaCtl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TanyaShue/MaaCtl.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/TanyaShue/MaaCtl/issues"
  },
  "bin": {
    "maactl": "bin/maactl.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "optionalDependencies": {
    "maactl-win32-x64": "0.1.0",
    "maactl-win32-arm64": "0.1.0",
    "maactl-linux-x64": "0.1.0",
    "maactl-linux-arm64": "0.1.0",
    "maactl-darwin-x64": "0.1.0",
    "maactl-darwin-arm64": "0.1.0"
  },
  "scripts": {
    "version": "node scripts/platform-packages.js sync-version",
    "platforms:prepare": "node scripts/platform-packages.js prepare",
    "platforms:link": "node scripts/platform-packages.js link",
    "platforms:publish": "node scripts/platform-packages.js publish",
    "check:platforms": "node scripts/platform-packages.js check",
    "test": "node --test",
    "prepublishOnly": "npm test && npm run check:platforms"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
