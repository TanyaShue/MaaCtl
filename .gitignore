# Build outputs and runtime artifacts
/maactl
/maactl*.exe
/dist/
/debug/

# MaaFramework runtime is supplied locally or with releases
/maafw/

# MaaFramework payload embedded by bundled builds (generated by tools/packmaafw)
/internal/maafw/bundled/payload/*
!/internal/maafw/bundled/payload/README.md

# MaaFramework release archives kept locally, unpacked into maafw/ by hand
/assets/

# npm wrapper
/npm/node_modules/
/npm/vendor/
/npm/platforms/
/npm/*.tgz

# Editor and OS files
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
__pycache__/